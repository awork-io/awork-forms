# JWT secret for session tokens (min 32 chars)
JWT_SECRET_KEY=your-secret-key-at-least-32-characters-long

# PostgreSQL connection (optional - uses Docker Compose default if not set)
# DATABASE_URL=Host=localhost;Database=awork_forms;Username=postgres;Password=postgres

# Base URL for OAuth redirects (optional - defaults to localhost:5173)
# BASE_URL=https://your-domain.com

# Backend Sentry error tracking (optional)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=awork-forms@1.0.0
# SENTRY_SEND_DEFAULT_PII=false

# Frontend Sentry error tracking (optional)
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=awork-forms@1.0.0
